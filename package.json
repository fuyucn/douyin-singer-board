{
  "name": "sususongboard",
  "private": true,
  "version": "0.42.0-susu.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sidecar:dev": "pnpm -F sidecar dev",
    "sidecar:build": "pnpm -F sidecar build",
    "sidecar:build:bin": "pnpm -F sidecar build:bin",
    "tauri": "tauri",
    "tauri:dev": "pnpm sidecar:build && node scripts/dev.mjs",
    "tauri:build": "pnpm sidecar:build:bin && tauri build",
    "tauri:build:dev": "pnpm sidecar:build:bin && VITE_DEBUG=true tauri build",
    "bump": "node scripts/bump-patch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "msw",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@yao-pkg/pkg": "6.19.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  }
}
