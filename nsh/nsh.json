{
  "name": "SUSUSongBoard",
  "id": "com.sususongboard.app",
  "version": "0.8.0",
  "build": 800,
  "rust": "native",
  "icon": "assets/icon.png",
  "window": {
    "title": "SUSUSongBoard",
    "defaultSize": {
      "width": 900,
      "height": 700
    },
    "minSize": {
      "width": 880,
      "height": 560
    }
  },
  "capabilities": {
    "fs": {
      "read": [
        "${dataDir}",
        "${homeDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    },
    "picker": true,
    "network": {
      "hosts": [
        "live.douyin.com",
        "*.douyin.com",
        "gateway.kugou.com",
        "login-user.kugou.com",
        "cloudlist.service.kugou.com",
        "ws.postman-echo.com"
      ]
    },
    "statusBar": true,
    "clipboard": true
  },
  "theme": "theme.json",
  "updater": {
    "github": "fuyucn/douyin-singer-board",
    "publicKey": "/mg2DCiu7KzF/hRF+l7s8JQNZzb2Jph7447Ha8J4Uqk="
  }
}
